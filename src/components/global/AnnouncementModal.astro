---

---

<div
  id="announcement-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden"
>
  <!-- Backdrop -->
  <div
    id="announcement-backdrop"
    class="fixed inset-0 bg-black/75 backdrop-blur-md opacity-0 transition-opacity duration-300"
  >
  </div>

  <!-- Modal Content Container -->
  <div
    id="announcement-content"
    class="bg-gray-950/95 border border-yellow-500/30 rounded-3xl p-6 sm:p-8 max-w-lg w-full relative z-10 shadow-2xl text-center transform scale-95 opacity-0 transition-all duration-300 ease-out backdrop-blur-xl"
  >
    <!-- Top Decorative Light/Glow -->
    <div
      class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-32 bg-yellow-500/10 blur-3xl rounded-full pointer-events-none"
    >
    </div>

    <!-- Custom Transition Map/Illustration (Sun to Mountains) -->
    <svg
      viewBox="0 0 400 120"
      class="w-full max-w-xs mx-auto mb-4 text-yellow-500"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Sun & Waves (Montpellier) -->
      <g>
        <circle cx="60" cy="45" r="18" fill="url(#sun-gradient)"></circle>
        <path
          d="M60 15v6M60 69v6M30 45h6M90 45h6M39 24l4 4M77 62l4 4M39 66l4-4M77 28l4-4"
          stroke="#fbbf24"
          stroke-width="2"
          stroke-linecap="round"></path>
      </g>
      <path
        d="M30 85c10 0 15-5 25-5s15 5 25 5 15-5 25-5 15 5 25 5"
        stroke="#38bdf8"
        stroke-width="2.5"
        stroke-linecap="round"></path>
      <path
        d="M40 93c8 0 12-4 20-4s12 4 20 4 12-4 20-4 12 4 20 4"
        stroke="#0284c7"
        stroke-width="1.5"
        stroke-linecap="round"></path>
      <text
        x="60"
        y="112"
        fill="#94a3b8"
        font-size="11"
        font-weight="600"
        text-anchor="middle"
        letter-spacing="1">MONTPELLIER</text
      >

      <!-- Transition path & truck -->
      <g>
        <path
          d="M140 60h120"
          stroke="#fbc02d"
          stroke-width="2"
          stroke-dasharray="6 6"
          stroke-linecap="round"></path>
        <path
          d="M255 52l10 8-10 8"
          stroke="#fbc02d"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>

        <!-- Moving Truck -->
        <g class="animate-bounce" style="animation-duration: 2.5s;">
          <rect x="180" y="42" width="28" height="14" rx="2" fill="#fbc02d"
          ></rect>
          <path d="M208 47h6l4 5v4h-10z" fill="#f59e0b"></path>
          <circle
            cx="188"
            cy="58"
            r="3.5"
            fill="#0f172a"
            stroke="#fbc02d"
            stroke-width="1"></circle>
          <circle
            cx="204"
            cy="58"
            r="3.5"
            fill="#0f172a"
            stroke="#fbc02d"
            stroke-width="1"></circle>
        </g>
      </g>

      <!-- Mountains (Gap) -->
      <g>
        <path d="M280 90l35-50 35 50z" fill="url(#mountain-back)"></path>
        <path d="M310 90l40-60 40 60z" fill="url(#mountain-front)"></path>
        <path d="M340 45l10-15 10 15-5 5-5-2-5 2z" fill="#ffffff"></path>
        <path d="M305 55l10-15 10 15-5 4-5-2-5 2z" fill="#f8fafc"></path>
      </g>
      <text
        x="350"
        y="112"
        fill="#94a3b8"
        font-size="11"
        font-weight="600"
        text-anchor="middle"
        letter-spacing="1">GAP (ALPES)</text
      >

      <defs>
        <radialGradient
          id="sun-gradient"
          cx="0"
          cy="0"
          r="1"
          gradientUnits="userSpaceOnUse"
          gradientTransform="translate(60 45) rotate(90) scale(18)"
        >
          <stop stop-color="#fbbf24"></stop>
          <stop offset="1" stop-color="#f59e0b"></stop>
        </radialGradient>
        <linearGradient
          id="mountain-front"
          x1="350"
          y1="30"
          x2="350"
          y2="90"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#64748b"></stop>
          <stop offset="1" stop-color="#334155"></stop>
        </linearGradient>
        <linearGradient
          id="mountain-back"
          x1="315"
          y1="40"
          x2="315"
          y2="90"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#475569"></stop>
          <stop offset="1" stop-color="#1e293b"></stop>
        </linearGradient>
      </defs>
    </svg>

    <!-- Heading -->
    <h2 class="text-2xl font-bold text-yellow-500 mb-2">
      Déménagement imminent !
    </h2>
    <p class="text-white text-base font-semibold mb-4 tracking-wide">
      Le Bar à outils prend de l'altitude 🏔️
    </p>

    <!-- Content -->
    <div
      class="text-gray-300 text-sm sm:text-base leading-relaxed text-left space-y-3 mb-6"
    >
      <p>
        Toutes les bonnes choses ont une fin... Après avoir équipé vos plus
        beaux chantiers montpelliérains, il est temps pour nous de plier bagage
        !
      </p>
      <p class="border-l-4 border-yellow-500 pl-3 bg-yellow-500/5 py-1">
        📅 <strong class="text-yellow-400"
          >Dernier jour de location : le 19 juillet.</strong
        > Au-delà de cette date, les locations ne seront plus possibles à Montpellier.
        Un immense <strong>MERCI</strong> pour votre confiance et les souvenirs !
        ❤️
      </p>
      <p>
        Mais séchez vos larmes ! Pour les amoureux des sommets (ou ceux de
        passage), nous posons nos caisses à outils dans les <strong
          class="text-white">Hautes-Alpes (agglomération de Gap)</strong
        > dès la rentrée pour y poursuivre nos locations.
      </p>
    </div>

    <!-- Dismiss Button -->
    <button
      id="announcement-dismiss"
      class="w-full sm:w-auto px-8 py-3 rounded-full font-bold bg-yellow-500 text-slate-950 border-2 border-yellow-500 hover:bg-transparent hover:text-yellow-500 hover:border-yellow-500 transition-all duration-300 transform active:scale-95 cursor-pointer shadow-lg shadow-yellow-500/20"
    >
      En route vers les Alpes ! 🚀
    </button>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("announcement-modal");
    const backdrop = document.getElementById("announcement-backdrop");
    const content = document.getElementById("announcement-content");
    const dismissBtn = document.getElementById("announcement-dismiss");

    if (modal && dismissBtn && backdrop && content) {
      // Check if user has already dismissed this announcement
      const isDismissed = localStorage.getItem(
        "announcement-dismissed-gap-migration",
      );

      if (!isDismissed) {
        // Show modal structure
        modal.classList.remove("hidden");

        // Trigger smooth opacity & scale animations
        requestAnimationFrame(() => {
          backdrop.classList.remove("opacity-0");
          backdrop.classList.add("opacity-100");
          content.classList.remove("scale-95", "opacity-0");
          content.classList.add("scale-100", "opacity-100");
        });
      }

      // Smooth hide logic
      const hideModal = () => {
        backdrop.classList.remove("opacity-100");
        backdrop.classList.add("opacity-0");
        content.classList.remove("scale-100", "opacity-100");
        content.classList.add("scale-95", "opacity-0");

        setTimeout(() => {
          modal.classList.add("hidden");
        }, 300);
      };

      // Handle dismiss button click
      dismissBtn.addEventListener("click", () => {
        localStorage.setItem("announcement-dismissed-gap-migration", "true");
        hideModal();
      });

      // Also allow closing by clicking the backdrop
      backdrop.addEventListener("click", () => {
        hideModal();
      });
    }
  });
</script>
